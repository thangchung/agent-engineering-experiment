<Project Sdk="Aspire.AppHost.Sdk/13.4.6">

  <!--
    Aspire.AppHost.Sdk generates the Projects.* namespace from these
    ProjectReference items at build time. No compile-time link — the
    SDK turns them into Aspire resource references.
  -->
  <ItemGroup>
    <ProjectReference Include="..\LoopRuntime.Mcp\LoopRuntime.Mcp.csproj" />
    <ProjectReference Include="..\LoopRuntime.Checker\LoopRuntime.Checker.csproj" />
    <ProjectReference Include="..\LoopRuntime.Executor\LoopRuntime.Executor.csproj" />
    <ProjectReference Include="..\LoopRuntime.ServiceDefaults\LoopRuntime.ServiceDefaults.csproj" IsAspireProjectResource="false" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="OpenTelemetry.Extensions.Hosting" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <!-- AppHost is excluded from solution build; run via `aspire start` -->
    <IsAspireHost>true</IsAspireHost>
    <UserSecretsId>55073060-8030-4f4d-ba74-e7aa2276206d</UserSecretsId>
  </PropertyGroup>

</Project>
