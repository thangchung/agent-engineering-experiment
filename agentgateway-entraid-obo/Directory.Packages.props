<Project>
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup>
    <!-- Aspire orchestration (Aspire.Hosting.AppHost is implicit via Aspire.AppHost.Sdk) -->
    <PackageVersion Include="Aspire.Hosting" Version="13.4.6" />

    <!-- OTel for ServiceDefaults (Phase 1) -->
    <PackageVersion Include="Microsoft.Extensions.Http.Resilience" Version="10.7.0" />
    <PackageVersion Include="Microsoft.Extensions.ServiceDiscovery" Version="10.7.0" />
    <PackageVersion Include="OpenTelemetry.Extensions.Hosting" Version="1.15.3" />
    <PackageVersion Include="OpenTelemetry.Exporter.OpenTelemetryProtocol" Version="1.15.3" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.AspNetCore" Version="1.12.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Http" Version="1.12.0" />
    <PackageVersion Include="OpenTelemetry.Instrumentation.Runtime" Version="1.16.0" />

    <!-- Hosting/config (used by tests + later phases) -->
    <PackageVersion Include="Microsoft.Extensions.Hosting" Version="10.0.8" />

    <!-- Auth / Entra Agent ID (Phase 5/6) -->
    <PackageVersion Include="Microsoft.Identity.Web" Version="3.10.0" />
    <PackageVersion Include="Microsoft.Identity.Web.AgentIdentities" Version="3.10.0" />
    <PackageVersion Include="Microsoft.Identity.Abstractions" Version="10.0.0" />
    <!-- Microsoft Agent Framework + IChatClient (Phase 5) -->
    <PackageVersion Include="Microsoft.Agents.AI" Version="1.13.0" />
    <PackageVersion Include="Microsoft.Agents.AI.Abstractions" Version="1.13.0" />
    <PackageVersion Include="Microsoft.Extensions.AI" Version="10.6.0" />
    <PackageVersion Include="Microsoft.Extensions.AI.OpenAI" Version="10.6.0" />
    <!-- MCP C# SDK (Phase 4/5) -->
    <PackageVersion Include="ModelContextProtocol" Version="1.2.0" />
    <PackageVersion Include="ModelContextProtocol.Core" Version="1.2.0" />
    <PackageVersion Include="ModelContextProtocol.AspNetCore" Version="1.2.0" />
    <!-- EF Core + SQLite (Phase 4) -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.10" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10" />
    <!-- OpenAPI (Phase 6) -->
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <!-- Explicit direct reference (TodoApi) pins this above the vulnerable transitive
         2.0.0 default. GHSA-v5pm-xwqc-g5wc's 2.x line is vulnerable up to 2.7.4, patched at 2.7.5. -->
    <PackageVersion Include="Microsoft.OpenApi" Version="2.7.5" />
    <PackageVersion Include="Scalar.AspNetCore" Version="2.16.16" />

    <!-- Tests -->
    <PackageVersion Include="coverlet.collector" Version="6.0.4" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageVersion Include="xunit" Version="2.9.3" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.4" />
    <!-- Dynamic runtime skip for the Docker+Entra-dependent integration test (TASK-039).
         Plain [Fact(Skip=...)] can't take a runtime-computed reason in xunit 2.x. -->
    <PackageVersion Include="Xunit.SkippableFact" Version="1.5.23" />
    <!-- Transitive via Microsoft.NET.Test.Sdk; default-resolved 9.0.0 is CVE-flagged
         (GHSA-23rf-6693-g89p, DoS in EncryptedXml), patched at 10.0.10. -->
    <PackageVersion Include="System.Security.Cryptography.Xml" Version="10.0.10" />
  </ItemGroup>
</Project>
