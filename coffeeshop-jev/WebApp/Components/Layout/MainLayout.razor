@inherits LayoutComponentBase
@inject OrderSession Session
@implements IDisposable

<a class="skip" href="#main">Skip to content</a>

<header class="topbar">
    <div class="brand">
        <span class="brand-mark" aria-hidden="true"></span>
        <span class="brand-name">The Counter</span>
    </div>

    <nav class="tabs" aria-label="Sections">
        <NavLink href="" Match="NavLinkMatch.All" data-testid="nav-order">Order</NavLink>
        <NavLink href="menu" data-testid="nav-menu">Menu @if (CartCount > 0) {<span class="cart-count" data-testid="cart-count">@CartCount</span>}</NavLink>
        <NavLink href="orders" data-testid="nav-orders">Your orders</NavLink>
    </nav>

    <div class="tools" @onkeydown="OnKey">
        <button class="theme-btn" type="button" aria-pressed="@_dark.ToString().ToLowerInvariant()" aria-label="Dark theme" title="Switch theme" data-testid="theme-toggle" @onclick="ToggleTheme">
            <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" aria-hidden="true"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
            <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
        </button>
        <button class="guest" type="button" aria-haspopup="true" aria-expanded="@_pop.ToString().ToLowerInvariant()" data-testid="guest-btn" @onclick="() => _pop = !_pop">
            <span class="guest-dot" aria-hidden="true"></span><span>@(Session.CustomerId.Length > 0 ? Session.CustomerId : "Guest")</span>
        </button>
        @if (_pop)
        {
            <div class="popover" data-testid="guest-pop">
                <p class="pop-title">This browser's guest id</p>
                <p class="pop-id" data-testid="guest-id">@Session.CustomerId</p>
                <p class="pop-note">Your order history is tied to this id, not to a login. Anyone with the id can see these orders.</p>
                <button type="button" class="btn ghost" data-testid="new-guest" @onclick="NewGuest">Start as a new guest</button>
                <hr />
                <label class="switch"><input type="checkbox" data-testid="show-events" checked="@Session.ShowEvents" @onchange="e => Session.ShowEvents = (bool)e.Value!" /> Show AG-UI events</label>
            </div>
        }
    </div>
</header>

<AgentBoundary Agent="Session.Agent">
    <main id="main">@Body</main>
</AgentBoundary>

@if (Session.ShowEvents)
{
    <aside class="events" aria-label="AG-UI events" data-testid="events">
        <header><h2>AG-UI events</h2><button type="button" class="btn ghost small" @onclick="ClearEvents">Clear</button></header>
        <ol>
            @foreach (var e in Session.Events)
            {
                <li><span class="ev-type @(e.Type == "RUN_ERROR" ? "err" : "")">@e.Type</span> @e.Detail</li>
            }
        </ol>
    </aside>
}

@code {
    private bool _dark;
    private bool _pop;

    private int CartCount => Session.Cart.Values.Sum();

    protected override void OnInitialized() => Session.Changed += OnChanged;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dark = await Session.JsAsync<bool>("cs.isDark");
            await Session.InitAsync();
            StateHasChanged();
        }
    }

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    private async Task ToggleTheme() => _dark = await Session.JsAsync<bool>("cs.toggleTheme");

    private async Task NewGuest()
    {
        _pop = false;
        await Session.NewGuestAsync();
    }

    private void ClearEvents() => Session.Events.Clear();

    private void OnKey(KeyboardEventArgs e)
    {
        if (e.Key == "Escape")
        {
            _pop = false;
        }
    }

    public void Dispose() => Session.Changed -= OnChanged;
}
