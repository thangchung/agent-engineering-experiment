<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" />
    <PackageReference Include="xunit" />
    <PackageReference Include="xunit.runner.visualstudio" />
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\ServiceDefaults\ServiceDefaults.csproj" />
    <ProjectReference Include="..\..\src\Jev.Client\Jev.Client.csproj" />
    <ProjectReference Include="..\..\src\ProductCatalogService\ProductCatalogService.csproj">
      <!-- Both CounterService and ProductCatalogService generate a top-level-statements
           "Program" class; alias this one so EndpointTests can reference CounterService's
           Program (WebApplicationFactory<Program>) without an ambiguous-type error. -->
      <Aliases>ProductCatalogServiceAsm</Aliases>
    </ProjectReference>
    <ProjectReference Include="..\..\src\CounterService\CounterService.csproj" />
  </ItemGroup>

</Project>
